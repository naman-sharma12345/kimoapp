{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-perf/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next-production/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-final/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".pages-build",
    ".next-production",
    ".next-perf",
    ".next-final"
  ]
}
