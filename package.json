{
  "name": "kimo-web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @kimo/web dev",
    "mock": "pnpm --filter @kimo/mock-server start",
    "mock:demo": "node --experimental-strip-types packages/mock-server/src/demo.ts",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "build": "eslint apps/web/src --max-warnings 0 && pnpm --filter @kimo/web build",
    "e2e": "playwright test",
    "shots": "playwright test e2e/screenshots.spec.ts",
    "postinstall": "node scripts/fixtures.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "15.5.28",
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "26.1.0",
    "prettier": "^3.6.2",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
