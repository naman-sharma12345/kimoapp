{
  "name": "kimo-desktop",
  "productName": "kimo",
  "version": "0.4.3",
  "description": "kimo video editor for Windows: the real kimo v6 engine, FFmpeg and whisper on your PC",
  "author": "kimo <hello@getkimo.tech>",
  "homepage": "https://getkimo.tech",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/transcript.test.mjs test/captions.test.mjs test/cutplan.test.mjs test/edl.test.mjs test/compose.test.mjs test/compose-fx.test.mjs test/camera.test.mjs test/camera-render.test.mjs test/graphics.test.mjs test/explain.test.mjs test/auth.test.mjs test/pipeline.test.mjs test/bench/cache.test.mjs test/bench/metrics.test.mjs test/bench/resources.test.mjs test/bench/encoding.test.mjs test/audio.test.mjs test/color.test.mjs test/planner.test.mjs test/studio.test.mjs test/release-quality.test.mjs test/updater.test.mjs",
    "test:audio": "node --test --test-concurrency=1 test/audio.test.mjs",
    "bench:fetch": "node test/bench/fetch-clips.mjs",
    "bench": "node test/bench/run.mjs",
    "graphics:previews": "node test/bench/graphics-previews.mjs",
    "graphics:gallery": "node test/bench/graphics-gallery.mjs",
    "start": "electron .",
    "build:renderer": "vite build --config renderer/vite.config.mjs",
    "dev:renderer": "vite --config renderer/vite.config.mjs",
    "dist": "electron-builder --win nsis --publish never",
    "dist:online": "node distribution/build-online.mjs",
    "test:color": "node --test --test-concurrency=1 test/color.test.mjs",
    "test:planner": "node --test --test-concurrency=1 test/planner.test.mjs"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.548.0",
    "motion": "^12.43.0",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "vite": "^6.4.5"
  },
  "build": {
    "appId": "tech.getkimo.desktop",
    "productName": "kimo",
    "artifactName": "kimo-Setup-${version}.${ext}",
    "files": [
      "main.cjs",
      "updater-policy.cjs",
      "distribution/delta.cjs",
      "preload.cjs",
      "engine.mjs",
      "edl.mjs",
      "compose.mjs",
      "compose-text.mjs",
      "compose-fx.mjs",
      "picture-tools.mjs",
      "encoding.mjs",
      "resources.cjs",
      "sam.mjs",
      "kimo-auth.mjs",
      "transcript.mjs",
      "cutplan.mjs",
      "cutstage.mjs",
      "judgment.mjs",
      "joins.mjs",
      "speakers.mjs",
      "camera.mjs",
      "camera-probe.mjs",
      "captions.mjs",
      "caption-edits.mjs",
      "caption-render.mjs",
      "caption-selftest.mjs",
      "ass.mjs",
      "fonts.mjs",
      "broll.mjs",
      "compose-graphics.mjs",
      "graphics/**",
      "explain/**",
      "audio/**",
      "!audio/tools/**",
      "!explain/tools/**",
      "!explain/previews/**",
      "!graphics/previews/**",
      "fonts/**",
      "data/**",
      "renderer/**",
      "!renderer/src/**",
      "!renderer/vite.config.mjs",
      "package.json",
      "color/**",
      "!color/tools/**",
      "planner.mjs",
      "planner/**",
      "creator-engine.mjs",
      "critic.mjs",
      "schemas/**",
      "prompts/**",
      "test/bench/metrics.mjs",
      "test/bench/io.mjs",
      "studio.mjs",
      "studio-model.mjs",
      "studio-ipc.mjs",
      "quality-gates.mjs",
      "input-media.mjs",
      "project-state.mjs",
      "worker-pool.mjs",
      "creator-smoke.mjs"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "kimo"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "naman-sharma12345",
        "repo": "kimoapp",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "audio/music/**",
      "audio/sfx/**",
      "fonts/**"
    ]
  }
}
