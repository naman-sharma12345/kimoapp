{
  "name": "kimo-desktop",
  "productName": "kimo",
  "version": "0.3.0",
  "description": "kimo video editor for Windows: the real kimo v6 engine, FFmpeg and whisper on your PC",
  "author": "kimo <hello@getkimo.tech>",
  "homepage": "https://getkimo.tech",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tech.getkimo.desktop",
    "productName": "kimo",
    "artifactName": "kimo-Setup-${version}.${ext}",
    "files": [
      "main.cjs",
      "preload.cjs",
      "engine.mjs",
      "sam.mjs",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "kimo"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "naman-sharma12345",
        "repo": "kimoapp",
        "releaseType": "release"
      }
    ]
  }
}
