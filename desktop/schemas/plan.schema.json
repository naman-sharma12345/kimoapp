{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kimo creator plan v1",
  "type": "object",
  "properties": {
    "template": {
      "type": "string",
      "enum": [
        "shorts-punchy",
        "shorts-clean",
        "youtube-talking",
        "youtube-vlog",
        "tutorial",
        "podcast-clips",
        "documentary",
        "explainer",
        "music-montage"
      ]
    },
    "story": {
      "type": "object",
      "properties": {
        "hook": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "sentence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                "trim_words": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "maxItems": 2,
                  "minItems": 2
                },
                "why": {
                  "type": "string",
                  "maxLength": 200
                },
                "hook_text": {
                  "type": "string",
                  "maxLength": 60
                }
              },
              "required": ["sentence", "trim_words", "why", "hook_text"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "maxItems": 2000,
          "uniqueItems": true
        },
        "drop": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sentence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "why": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": ["sentence", "why"],
            "additionalProperties": false
          },
          "maxItems": 2000
        },
        "best_take": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "keep_pause_after": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "maxItems": 200,
          "uniqueItems": true
        }
      },
      "required": ["hook", "order", "drop", "best_take", "keep_pause_after"],
      "additionalProperties": false
    },
    "emphasis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sentence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "word": {
            "type": "string",
            "maxLength": 60
          },
          "kind": {
            "type": "string",
            "enum": [
              "number",
              "contrast",
              "name",
              "claim",
              "emotion",
              "punchline"
            ]
          },
          "treat": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["camera_snap", "number_pop", "sfx_pop"]
            },
            "maxItems": 3
          }
        },
        "required": ["sentence", "word", "kind", "treat"],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "camera": {
      "type": "object",
      "properties": {
        "energy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "range": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 86400
                },
                "maxItems": 2,
                "minItems": 2
              },
              "framing": {
                "type": "string",
                "enum": ["wide", "medium", "tight", "extreme"]
              },
              "why": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": ["range", "framing", "why"],
            "additionalProperties": false
          },
          "maxItems": 50
        }
      },
      "required": ["energy", "overrides"],
      "additionalProperties": false
    },
    "captions": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "style": {
          "type": "string",
          "enum": [
            "kimo",
            "hormozi",
            "mrbeast",
            "ali-abdaal",
            "mkbhd",
            "karaoke",
            "doc-subtitle",
            "boxed-highlight"
          ]
        },
        "accent_words": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 60
          },
          "maxItems": 100
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 40
        },
        "font_scale": {
          "type": "number",
          "minimum": 0.55,
          "maximum": 1.3
        },
        "position": {
          "type": "string",
          "enum": ["auto", "top", "bottom", "middle"]
        }
      },
      "required": [
        "enabled",
        "style",
        "accent_words",
        "hints",
        "font_scale",
        "position"
      ],
      "additionalProperties": false
    },
    "graphics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "hook_title",
              "lower_third",
              "stat",
              "chapter",
              "callout",
              "progress",
              "cta"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "role": {
            "type": "string",
            "maxLength": 80
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "value": {
            "type": "string",
            "maxLength": 40
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400
          },
          "at_sentence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "dur": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 30
          }
        },
        "required": ["kind"],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "broll": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sentence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "clip": {
            "type": "string",
            "maxLength": 40
          },
          "why": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": ["sentence", "clip", "why"],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "music": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mood": {
          "type": "string",
          "enum": [
            "upbeat",
            "calm",
            "chill-lofi",
            "cinematic",
            "tech",
            "energetic",
            "warm",
            "curious",
            "playful"
          ]
        },
        "track": {
          "type": "string",
          "enum": [
            "auto",
            "warm-notebook",
            "bright-steps",
            "quiet-document",
            "neon-free-drive",
            "soft-focus",
            "curious-mechanism",
            "wide-horizon",
            "late-morning"
          ]
        },
        "drop_at_sentence": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["enabled", "mood", "track", "drop_at_sentence"],
      "additionalProperties": false
    },
    "sfx": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at_event": {
            "type": "string",
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "whoosh",
              "swish",
              "pop",
              "click",
              "riser",
              "impact",
              "ding",
              "shutter",
              "keyboard",
              "glitch",
              "paper",
              "tap"
            ]
          }
        },
        "required": ["at_event", "kind"],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "explainers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "list",
              "flow",
              "timeline",
              "chart",
              "compare",
              "definition",
              "code",
              "quote",
              "stat",
              "question"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 100
                },
                "say_word_idx": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                }
              },
              "required": ["text", "say_word_idx"],
              "additionalProperties": false
            },
            "maxItems": 12
          },
          "start_word_idx": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "end_word_idx": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "family",
          "title",
          "items",
          "start_word_idx",
          "end_word_idx"
        ],
        "additionalProperties": false
      },
      "maxItems": 60
    },
    "look": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "clean",
            "warm-creator",
            "mkbhd-crisp",
            "cinematic-teal-orange",
            "vlog-bright",
            "moody-doc",
            "kimo"
          ]
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["id", "strength"],
      "additionalProperties": false
    },
    "title_pack": {
      "type": "object",
      "properties": {
        "titles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "maxItems": 3,
          "minItems": 3
        },
        "thumbnail_text": {
          "type": "string",
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 4500
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sentence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "title": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": ["sentence", "title"],
            "additionalProperties": false
          },
          "maxItems": 50
        }
      },
      "required": ["titles", "thumbnail_text", "description", "chapters"],
      "additionalProperties": false
    }
  },
  "required": [
    "template",
    "story",
    "emphasis",
    "camera",
    "captions",
    "graphics",
    "broll",
    "music",
    "sfx",
    "explainers",
    "look",
    "title_pack"
  ],
  "additionalProperties": false
}
