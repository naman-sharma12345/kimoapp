{
  "id": "mkbhd",
  "name": "MKBHD",
  "description": "Minimal 16:9 lower-centre, Geist Bold white with a soft shadow, no box, one line, 120 ms fade.",
  "kind": "caption",
  "font": {
    "file": "Geist-Bold.ttf",
    "family": "Geist Bold",
    "weight": 700
  },
  "font_devanagari": {
    "file": "NotoSansDevanagari-Bold.ttf",
    "family": "Noto Sans Devanagari Bold",
    "weight": 700
  },
  "size": 0.034,
  "size_wide": 0.046,
  "case": "sentence",
  "colors": {
    "text": "#FFFFFF",
    "active": "#FFFFFF",
    "accent": "#FF3B30",
    "outline": "#000000",
    "shadow": "#000000"
  },
  "outline": 0.0,
  "shadow": 0.0018,
  "shadow_opacity": 0.65,
  "blur": 2,
  "box": null,
  "line_spacing": 1.0,
  "letter_spacing": 0,
  "layout": {
    "shorts": {
      "max_words": 4,
      "max_chars": 18,
      "max_lines": 1,
      "min_dur": 0.5
    },
    "wide": {
      "max_words": 7,
      "max_chars": 42,
      "max_lines": 1,
      "min_dur": 0.8
    }
  },
  "position": "bottom",
  "highlight": "none",
  "animation": {
    "in": {
      "type": "fade",
      "frames": 0,
      "ms": 120,
      "easing": "linear"
    },
    "out": {
      "type": "fade",
      "frames": 0,
      "ms": 120
    }
  },
  "accent": {
    "enabled": true,
    "max_per_chunk": 1,
    "ratio": [
      0.1,
      0.25
    ],
    "numbers": true,
    "names": true
  },
  "punctuation": "keep",
  "numbers": "digits",
  "max_cps": 17
}
