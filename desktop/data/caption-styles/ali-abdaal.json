{
  "id": "ali-abdaal",
  "name": "Ali Abdaal",
  "description": "Clean Geist SemiBold, sentence case, white on a soft black pill at 70%, two lines, word-by-word reveal 40% to 100%, no bounce.",
  "kind": "caption",
  "font": {
    "file": "Geist-SemiBold.ttf",
    "family": "Geist SemiBold",
    "weight": 600
  },
  "font_devanagari": {
    "file": "NotoSansDevanagari-Bold.ttf",
    "family": "Noto Sans Devanagari Bold",
    "weight": 700
  },
  "size": 0.05,
  "size_wide": 0.05,
  "case": "sentence",
  "colors": {
    "text": "#FFFFFF",
    "active": "#FFFFFF",
    "accent": "#FFD166",
    "outline": "#000000",
    "shadow": "#000000"
  },
  "outline": 0.0,
  "shadow": 0.0,
  "shadow_opacity": 0.0,
  "box": {
    "color": "#000000",
    "opacity": 0.7,
    "radius": 0.42,
    "pad_x": 0.5,
    "pad_y": 0.32
  },
  "line_spacing": 1.12,
  "letter_spacing": 0,
  "layout": {
    "shorts": {
      "max_words": 6,
      "max_chars": 20,
      "max_lines": 2,
      "min_dur": 0.6
    },
    "wide": {
      "max_words": 8,
      "max_chars": 42,
      "max_lines": 2,
      "min_dur": 0.8
    }
  },
  "position": "auto",
  "highlight": "reveal",
  "animation": {
    "in": {
      "type": "fade",
      "frames": 3,
      "easing": "linear"
    },
    "out": {
      "type": "none",
      "frames": 0
    }
  },
  "reveal_opacity": 0.4,
  "accent": {
    "enabled": true,
    "max_per_chunk": 1,
    "ratio": [
      0.15,
      0.3
    ],
    "numbers": true,
    "names": true
  },
  "punctuation": "keep",
  "numbers": "digits"
}
