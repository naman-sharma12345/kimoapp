{
  "id": "kimo",
  "name": "kimo",
  "description": "Brand default: Geist Black caps, cream text, ink outline, orange keyword, subtle 1.04 pop.",
  "kind": "caption",
  "font": {
    "file": "Geist-Black.ttf",
    "family": "Geist Black",
    "weight": 900
  },
  "font_devanagari": {
    "file": "NotoSansDevanagari-Black.ttf",
    "family": "Noto Sans Devanagari Black",
    "weight": 900
  },
  "size": 0.076,
  "size_wide": 0.07,
  "case": "upper",
  "colors": {
    "text": "#F5F1E7",
    "active": "#FFFFFF",
    "accent": "#FF5A24",
    "outline": "#0E0D0C",
    "shadow": "#000000"
  },
  "outline": 0.0055,
  "shadow": 0.0022,
  "shadow_opacity": 0.55,
  "box": null,
  "line_spacing": 1.0,
  "letter_spacing": 0,
  "layout": {
    "shorts": {
      "max_words": 3,
      "max_chars": 14,
      "max_lines": 1,
      "min_dur": 0.3
    },
    "wide": {
      "max_words": 6,
      "max_chars": 42,
      "max_lines": 1,
      "min_dur": 0.8
    }
  },
  "position": "auto",
  "highlight": "active-colour",
  "animation": {
    "in": {
      "type": "pop",
      "frames": 4,
      "easing": "back-out",
      "from": 1.0,
      "peak": 1.04
    },
    "out": {
      "type": "none",
      "frames": 0
    }
  },
  "accent": {
    "enabled": true,
    "max_per_chunk": 1,
    "ratio": [
      0.2,
      0.35
    ],
    "numbers": true,
    "names": true
  },
  "punctuation": "strip",
  "numbers": "digits"
}
