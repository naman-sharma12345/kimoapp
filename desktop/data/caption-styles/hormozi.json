{
  "id": "hormozi",
  "name": "Hormozi",
  "description": "Montserrat Black caps, white, thick black outline, drop shadow, 1-2 words, current word yellow, keyword green, back-out pop.",
  "kind": "caption",
  "font": {
    "file": "Montserrat-Black.ttf",
    "family": "Montserrat Black",
    "weight": 900
  },
  "font_devanagari": {
    "file": "NotoSansDevanagari-Black.ttf",
    "family": "Noto Sans Devanagari Black",
    "weight": 900
  },
  "size": 0.085,
  "size_wide": 0.08,
  "case": "upper",
  "colors": {
    "text": "#FFFFFF",
    "active": "#FFE11A",
    "accent": "#2BE36B",
    "outline": "#000000",
    "shadow": "#000000"
  },
  "outline": 0.0068,
  "shadow": 0.0035,
  "shadow_opacity": 0.7,
  "box": null,
  "line_spacing": 1.0,
  "letter_spacing": 0,
  "layout": {
    "shorts": {
      "max_words": 2,
      "max_chars": 14,
      "max_lines": 1,
      "min_dur": 0.3
    },
    "wide": {
      "max_words": 4,
      "max_chars": 28,
      "max_lines": 1,
      "min_dur": 0.8
    }
  },
  "position": "auto",
  "highlight": "active-colour",
  "animation": {
    "in": {
      "type": "pop",
      "frames": 5,
      "easing": "back-out",
      "from": 0.7,
      "peak": 1.08
    },
    "out": {
      "type": "none",
      "frames": 0
    }
  },
  "accent": {
    "enabled": true,
    "max_per_chunk": 1,
    "ratio": [
      0.2,
      0.35
    ],
    "numbers": true,
    "names": true
  },
  "punctuation": "strip",
  "numbers": "digits"
}
